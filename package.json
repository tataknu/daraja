{
  "name": "daraja",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval": "bun packages/eval/src/run.ts"
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
  "devDependencies": {
    "prettier": "^3.7.3",
    "turbo": "^2.11.7"
  }
}
